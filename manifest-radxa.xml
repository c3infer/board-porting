<?xml version="1.0" encoding="UTF-8"?>
<!--
  Reproducible Radxa Rock 5B CAEC/Mica build.

  Initialise this workspace with:
    repo init -u git@github.com:YOUR_GITHUB_USER/board-porting.git -m manifest-radxa.xml
    repo sync -j8 (with no clone bundle)

  `board/` deliberately preserves the layout expected by the OpenCCA Docker
  build: the container mounts it at /opencca.
-->
<manifest>
  <!-- HTTPS keeps a fresh, public clone independent of developer SSH setup. -->
  <remote name="github" fetch="ssh://git@github.com/" />
  <remote name="c3infer" fetch="ssh://git@github.com/c3infer/" />
  <remote name="comet" fetch="ssh://git@github.com/comet-cc/" />
  <remote name="opencca" fetch="ssh://git@github.com/opencca/" />
  <!-- Replace YOUR_GITHUB_USER with the owner of the published manifest. -->
  <remote name="board-porting" fetch="ssh://git@github.com/YOUR_GITHUB_USER/" />

  <default remote="github" revision="main" sync-j="8" />

  <!-- Build orchestration, overlays and local patch series. -->
  <project name="board-porting" remote="board-porting" path="board/manifest"
           revision="main" />

  <!-- Canonical C3Infer board stack.  These are immutable upstream commits. -->
  <project name="host-linux-opencca" remote="c3infer" path="board/linux"
           revision="7d5e91cae4ad6ab8fcc89d54a9a054d27972cb00" upstream="main" />
  <project name="guest-linux-opencca" remote="c3infer" path="board/linux-guest"
           revision="d327b9c9569cb41652f7e5c00e0257540793ee8b" upstream="main" />
  <project name="qemu-opencca" remote="c3infer" path="board/qemu-vmm"
           revision="aee77fb938065b6db056eebf47cf91f570b3648c"
           upstream="cca/2025-06-12" />
  <project name="rmm-opencca" remote="c3infer" path="board/tf-rmm"
           revision="e541593ef36a88403497b639b0ba803e66d35e7a"
           upstream="mica-rebase-rmi-rsi" sync-s="true" />

  <!-- Board firmware, images, VM runner and deployment tooling. -->
  <project name="CAEC-paper/arm-trusted-firmware" path="board/trusted-firmware-a"
           revision="a6b720dbf635441d19297898e0860fb989877cbe" upstream="CAEC" />
  <project name="CAEC-paper/u-boot" path="board/u-boot"
           revision="2580869f3410e0b2154800541b9dc375ac01321c" />
  <project name="rkbin" remote="opencca" path="board/rkbin"
           revision="b0c100f1a260d807df450019774993c761beb79d" />
  <project name="debian-image-recipes" remote="opencca" path="board/debian-image-recipes"
           revision="06cf2e55d7b7aaad8da107abcbcf5463dd7b0474" />
  <project name="debos-fs" remote="comet" path="board/debos-fs"
           revision="71b6907bef45987008c14be83bbaf854fd38478e" />
  <project name="kvmtool-cca-CAEC" remote="comet" path="board/kvmtool"
           revision="6d41b06fae0752e09f37dca248b6dafbe142311e" />
  <project name="External-Modules-CAEC" remote="comet" path="board/External_modules"
           revision="c199064667e30fea460612622afcc535bc2f5cfd" />
  <project name="SinaAb7/opencca-build" path="board/opencca-build"
           revision="644beaf8cbd42f76c25c26ba6760ee368022b4ec" upstream="master" />
  <project name="SinaAb7/opencca-flash" path="board/opencca-flash"
           revision="50bb2daa7c336b34c3eae0fdb188680062920702" />
  <project name="opencca/opencca-assets" path="board/opencca-assets"
           revision="f75c95d15e485d8f147ff8fd4cc2f2513ed60131" />
  <project name="ggml-org/llama.cpp" path="board/llamacpp"
           revision="e02b597be3702174e7b47b44cd03e1da1553284b" />
</manifest>
